# Copy to .env.local. Never commit real values.

# Server only. Used by the "Extract claims" server action; never sent to the browser.
# Without it the app runs and shows "Extraction needs an API key".
OPENAI_API_KEY=

# Optional. The model used for claim extraction (default: gpt-4.1-mini).
# OPENAI_MODEL=gpt-4.1-mini

# Signs session cookies. Generate one with: openssl rand -base64 32
# If unset, a random secret is created once in .data/auth-secret (fine for local use).
BETTER_AUTH_SECRET=

# Optional. The public URL of this site, when it is not http://localhost:3000.
# BETTER_AUTH_URL=http://localhost:3000

# The engine API (FastAPI, api/server.py). Read by the browser.
NEXT_PUBLIC_CRUX_API=http://localhost:8001
