# The Crux engine API (api/server.py) for a hosted deploy such as Railway.
# Serves the recorded replays in runs/demo and runs the claims audit in-process; Task 9 runs
# still execute in Modal sandboxes and need OPENAI_API_KEY plus Modal tokens (see docs/DEPLOY.md).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

RUN pip install --no-cache-dir uv==0.12.21

WORKDIR /app

# Dependencies first, so code changes don't reinstall them.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN uv sync --frozen --no-dev

EXPOSE 8000
CMD ["sh", "-c", "uv run --no-sync uvicorn api.server:app --host 0.0.0.0 --port ${PORT:-8000}"]
